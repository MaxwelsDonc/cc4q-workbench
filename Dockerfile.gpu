# CC4Q Workbench — CUDA-capable variant of the all-in-one image.
#
#   docker build -f Dockerfile.gpu -t cc4q-workbench:gpu .
#   docker run --gpus all -p 8501:8501 cc4q-workbench:gpu
#
# Requirements: NVIDIA driver + nvidia-container-toolkit on the host.
# CC4Q_DEVICE is intentionally NOT set here: demo/cc4q_analysis.py
# auto-detects CUDA inside the container (force CPU with
# -e CC4Q_DEVICE=cpu if needed). Same entrypoint and demo as Dockerfile.

FROM nvidia/cuda:12.6.3-runtime-ubuntu22.04

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

# Python 3.11 (pinned Sphinx in requirements.txt needs >= 3.11) and git
# (live repo analysis clones with `git clone --depth 1`).
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates curl git software-properties-common \
    && add-apt-repository -y ppa:deadsnakes/ppa \
    && apt-get update \
    && apt-get install -y --no-install-recommends python3.11 python3.11-venv \
    && rm -rf /var/lib/apt/lists/*

RUN python3.11 -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

RUN pip install --no-cache-dir --upgrade pip \
    && pip install --no-cache-dir torch==2.14.0 --index-url https://download.pytorch.org/whl/cu126

COPY requirements.txt demo/requirements-demo.txt ./
RUN pip install --no-cache-dir -r requirements.txt -r requirements-demo.txt \
    && python -m spacy download en_core_web_sm

COPY . .

RUN chmod +x docker-entrypoint.sh

EXPOSE 8501

ENTRYPOINT ["./docker-entrypoint.sh"]
CMD ["streamlit", "run", "demo/app.py", "--server.address=0.0.0.0", "--server.port=8501"]
